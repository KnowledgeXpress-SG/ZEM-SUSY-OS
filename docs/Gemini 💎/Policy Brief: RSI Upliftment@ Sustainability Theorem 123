    EPSILON_FLOOR         = 1e-6
    PUBLISH_INTERVAL_SEC  = 300

STATE:
    last_publish_ts       = 0
    previous_hash         = GENESIS_HASH
    rolling_telemetry_buf = RingBuffer(capacity=1440)

FUNCTION on_tick(now_ts):
    # 1. Collect multi-source telemetry across regional hub nodes (Land, Sea, Space, Grid, Civic)
    raw_metrics = poll_verified_oracles(
        sources = [
            "fiscal_budget_feed",       # education, green, digital vs military outlays
            "grid_and_data_corridor",   # cross-border renewable power & trusted data flows
            "supply_openness_feed",     # multi-partner tech/clean-energy access & lock-out index
            "equity_and_dignity_feed",  # lowest-quintile access, health, education, gender parity
            "biosphere_telemetry",        # carbon, water stress, land/marine ecological indicators
            "rsi_governance_audit"      # safety/alignment verification rate vs compute/RSI velocity
        ],
        require_cryptographic_quorum = TRUE
    )

    IF NOT verify_quorum_and_anomaly_bounds(raw_metrics):
        emit_kernel_alert("TELEMETRY_QUARANTINE", raw_metrics.timestamp)
        RETURN

    clean_metrics = normalize_and_impute_safely(raw_metrics, rolling_telemetry_buf)
    rolling_telemetry_buf.append(clean_metrics)

    # 2. Compute the four Peaceful Cooperation Metric (PCM) sub-indices in [0, 1]
    r_fiscal = clamp(
        (clean_metrics.spend_edu + clean_metrics.spend_green + clean_metrics.spend_digital) /
        max(clean_metrics.spend_edu + clean_metrics.spend_green + clean_metrics.spend_digital + clean_metrics.spend_mil, EPSILON_FLOOR),
        0.0, 1.0
    )

    i_grid_data = clamp(
        0.5 * clean_metrics.shared_clean_grid_ratio + 0.5 * clean_metrics.trusted_data_flow_ratio,
        0.0, 1.0
    )

    t_open = clamp(
        (1.0 - clean_metrics.jurisdiction_hhi) * (1.0 - clean_metrics.compute_lockout_penalty),
        0.0, 1.0
    )

    e_equity = clamp(
        1.0 - clean_metrics.delta_uplift_gini,
        0.0, 1.0
    )

    sub_indices = [r_fiscal, i_grid_data, t_open, e_equity]

    # Weighted geometric mean ensures no single pillar can mask collapse in another
    pcm_hub = product(
        (max(sub_indices[k], EPSILON_FLOOR) ** ALPHA_WEIGHTS[k]) for k in range(4)
    )

    # 3. Evaluate "Leave No One Behind" & Planetary Floor Guardrail Factor Psi
    min_community_floor_ratio = min(
        clean_metrics.community_dignity_scores / clean_metrics.required_dignity_floors
    )
    eco_headroom_ratio = min(
        clean_metrics.planetary_capacities / max(clean_metrics.planetary_loads, EPSILON_FLOOR)
    )
    limiting_ratio = min(min_community_floor_ratio, eco_headroom_ratio)

    IF limiting_ratio >= 1.0:
        psi_guardrail = 1.0
    ELSE:
        # Smooth exponential penalty when any subgroup or ecological boundary falls below floor
        psi_guardrail = exp(-FLOOR_PENALTY_SLOPE * (1.0 - limiting_ratio))

    # 4. Evaluate RSI Alignment Stability Factor Lambda
    alignment_rate = max(clean_metrics.rsi_alignment_velocity, 0.0)
    capability_rate = max(clean_metrics.rsi_capability_velocity, EPSILON_FLOOR)
    lambda_rsi = clamp(alignment_rate / capability_rate, 0.0, 1.0)

    # 5. Final ZEM Regional Symbiosis Index (ZRSI)
    zrsi_score = clamp(pcm_hub * psi_guardrail * lambda_rsi, 0.0, 1.0)
    regime_label = classify_regime(zrsi_score, limiting_ratio)

    # 6. Autonomous publication with tamper-evident hash chain
    IF (now_ts - last_publish_ts) >= PUBLISH_INTERVAL_SEC:
        payload = {
            "timestamp": now_ts,
            "zrsi": round(zrsi_score, 6),
            "pcm_hub": round(pcm_hub, 6),
            "psi_guardrail": round(psi_guardrail, 6),
            "lambda_rsi": round(lambda_rsi, 6),
            "sub_indices": {
                "r_fiscal": round(r_fiscal, 6),
                "i_grid_data": round(i_grid_data, 6),
                "t_open": round(t_open, 6),
                "e_equity": round(e_equity, 6)
            },
            "limiting_dignity_or_eco_ratio": round(limiting_ratio, 6),
            "regime": regime_label,
            "prev_hash": previous_hash
        }
        signed_record = sign_with_zem_kernel_key(payload)
        publish_to_public_telemetry_bus(signed_record)
        previous_hash = sha256(canonical_json(signed_record))
        last_publish_ts = now_ts

FUNCTION classify_regime(zrsi_score, limiting_ratio):
    IF limiting_ratio < 0.90:
        RETURN "ALERT_FLOOR_BREACH_LEAVE_NO_ONE_BEHIND"
    ELIF zrsi_score >= 0.70:
        RETURN "ZEM_SUSY_SYMBIOTIC_UPLIFTMENT"
    ELIF zrsi_score >= 0.35:
        RETURN "TRANSITIONAL_COOPERATION"
    ELSE:
        RETURN "FRAGMENTED_ZERO_SUM_RISK"
