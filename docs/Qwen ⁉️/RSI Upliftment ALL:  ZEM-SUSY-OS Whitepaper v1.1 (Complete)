# 3. Simple Markdown to DOCX Parser
def add_markdown_to_docx(md_text, document):
    # Split by lines for basic parsing
    lines = md_text.split('\n')
    for line in lines:
        line = line.strip()
        if not line:
            continue
            
        # Headings
        if line.startswith('# '):
            p = document.add_heading(line[2:], level=1)
            p.alignment = WD_ALIGN_PARAGRAPH.CENTER
        elif line.startswith('## '):
            p = document.add_heading(line[3:], level=2)
        elif line.startswith('### '):
            p = document.add_heading(line[4:], level=3)
        elif line.startswith('#### '):
            p = document.add_heading(line[5:], level=4)
        # Blockquotes
        elif line.startswith('> '):
            p = document.add_paragraph(line[2:])
            p.italic = True
            p.left_indent = Inches(0.5)
        # Bold text (simple detection)
        elif '**' in line:
            p = document.add_paragraph()
            # A simple split to handle bolding
            parts = line.split('**')
            for i, part in enumerate(parts):
                if i % 2 == 1: # Bold part
                    run = p.add_run(part)
                    run.bold = True
                else:
                    p.add_run(part)
        # Bullet points
        elif line.startswith('- '):
            p = document.add_paragraph(line[2:], style='List Bullet')
        # Regular text
        else:
            document.add_paragraph(line)

# 4. Execute Conversion
print("Generating ZEM-SUSY-OS Whitepaper v1.1...")
add_markdown_to_docx(markdown_text, doc)

# 5. Save File
filename = "ZEM_SUSY_OS_Whitepaper_v1.1.docx"
doc.save(filename)
print(f"✅ Success! '{filename}' has been generated and is ready for distribution.")
```

