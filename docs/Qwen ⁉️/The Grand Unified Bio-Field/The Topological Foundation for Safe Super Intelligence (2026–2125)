                self.bivector(2, 4),           # W^+ analog
                self.bivector(3, 5),           # W^- analog
            ],
            # Hypercharge U(1)_Y
            'U1_hypercharge': (self.bivector(0, 1)
                               + self.bivector(2, 3)
                               + self.bivector(4, 5)),
        }

