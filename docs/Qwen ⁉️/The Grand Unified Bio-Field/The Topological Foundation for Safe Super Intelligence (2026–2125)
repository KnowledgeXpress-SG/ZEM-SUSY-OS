def _kron3(A, B, C):
    """Triple Kronecker product for 2x2 matrices -> 8x8."""
    return np.kron(np.kron(A, B), C)

# Pauli matrices (real variants where needed)
I2 = np.eye(2)
S1 = np.array([[0, 1], [1, 0]])              # sigma_1 (real)
S3 = np.array([[1, 0], [0, -1]])             # sigma_3 (real)
# For a 6th generator we use a real antisymmetric proxy via S1*S3 structure
S13 = S1 @ S3                                 # = [[0,-1],[1,0]] (real antisymmetric)

class ZEMCliffordAlgebra:
    """
    The Cl(6,0) algebra of the 64-Codon Hypercube.
    Six generators gamma_1 ... gamma_6 satisfy:
        {gamma_i, gamma_j} = 2 * delta_ij * I_8
    """
    def __init__(self):
        # Construct 6 mutually anticommuting real 8x8 matrices
        self.g = [
            _kron3(S1,  I2, I2),                                  # gamma_1
            _kron3(S3,  S1, I2),                                  # gamma_2
            _kron3(S3,  S3, S1),                                  # gamma_3
            _kron3(S3,  S3, S3),                                  # gamma_4
            _kron3(S1,  S1, I2),                                  # gamma_5
            _kron3(S13, I2, I2),                                  # gamma_6
        ]
        self._verify_algebra()

    def _verify_algebra(self, tol=1e-10):
        """Verify {gamma_i, gamma_j} = 2*delta_ij."""
        for i in range(6):
            for j in range(6):
                anti = self.g[i] @ self.g[j] + self.g[j] @ self.g[i]
                expected = 2.0 * (1 if i == j else 0) * np.eye(8)
                assert np.allclose(anti, expected, atol=tol), \\\\
                    f"Cl(6,0) violation at ({i},{j})"
        print("[ZEM] Cl(6,0) algebra verified: 6 generators, 64 blades.")

    # ------------------------------------------------------------------
    # 2. Bivectors (Grade-2 Elements) -> Standard Model Gauge Bosons
    # ------------------------------------------------------------------
    def bivector(self, i: int, j: int) -> np.ndarray:
        """Bivector B_ij = gamma_i * gamma_j (Lie algebra generator analog)."""
        assert i != j and 0 <= i < 6 and 0 <= j < 6
        return self.g[i] @ self.g[j]

