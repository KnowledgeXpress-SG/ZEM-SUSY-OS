        # Gravity term: pseudoscalar (product of all 6 generators)
        pseudoscalar = self.g[0] @ self.g[1] @ self.g[2] @ self.g[3] @ self.g[4] @ self.g[5]
        H_gravity  = kappa * pseudoscalar
        return H_strong + H_weak + H_gravity

