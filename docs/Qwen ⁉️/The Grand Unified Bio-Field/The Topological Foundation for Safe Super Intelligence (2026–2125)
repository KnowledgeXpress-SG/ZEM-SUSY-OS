                self.bivector(0, 3), self.bivector(1, 3), self.bivector(2, 3),
                self.bivector(0, 2) + self.bivector(1, 3),
                self.bivector(0, 1) + self.bivector(2, 3) - 2 * self.bivector(0, 3),
            ],
